# ==============================================================================
# Environment Configuration Template
# Project: An Agentic AI Framework for Autonomous Streaming Data Analytics
# ==============================================================================

# --- Global Environment & Logging ---
APP_ENV=development
APP_NAME=agentic-streaming-analytics
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=logs
RANDOM_SEED=42

# --- Kafka Settings ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_METRICS_TOPIC=raw-metrics
KAFKA_ANOMALY_EVENTS_TOPIC=anomaly-events
KAFKA_AGENT_DECISIONS_TOPIC=agent-decisions
KAFKA_CONSUMER_GROUP_STREAMING=spark-streaming-group
KAFKA_CONSUMER_GROUP_AGENT=langgraph-agent-group
KAFKA_AUTO_OFFSET_RESET=latest

# --- Spark Structured Streaming Settings ---
SPARK_APP_NAME=AgenticStreamingAnomalyDetection
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=./data/checkpoints/spark
SPARK_TRIGGER_PROCESSING_TIME=1 second

# --- Dataset Replay Settings ---
DATASET_NAME=AIOPS_KPI
DATASET_PATH=./data/raw/aiops_kpi.csv
REPLAY_SPEED_MULTIPLIER=1.0
REPLAY_BATCH_SIZE=1

# --- Streaming Detector Baseline (AADS) ---
DEFAULT_DETECTOR=AADS
AADS_WINDOW_SIZE=100
AADS_ANOMALY_THRESHOLD=3.0
AADS_DECAY_FACTOR=0.05

# --- Alternative Detectors ---
XSTREAM_NUM_COMPONENTS=32
HSTREE_NUM_TREES=25
HSTREE_MAX_DEPTH=15
RRCF_NUM_TREES=30
RRCF_TREE_SIZE=256

# --- LangGraph Agent & LLM Settings ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=15.0

# --- Vector Memory Settings ---
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
MEMORY_SIMILARITY_TOP_K=5

# --- Persistent Storage / Database ---
DATABASE_URL=sqlite:///./data/results.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/streaming_analytics

# --- Grafana Settings ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
